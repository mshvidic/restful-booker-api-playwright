{
  "name": "restful-booker-api-tests",
  "version": "1.0.0",
  "description": "API test automation framework for Restful-Booker built with Playwright and Allure",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep-invert @smoke",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "clean": "node -e \"['allure-results','allure-report','test-results'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\""
  },
  "keywords": [
    "playwright",
    "api-testing",
    "allure",
    "restful-booker"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
